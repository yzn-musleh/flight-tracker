TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
AVIATIONSTACK_API_KEY=your-aviationstack-api-key

# Where the SQLite database file lives. Commented out (defaults to
# flights.db next to bot.py) for a plain/systemd install; the Docker image
# sets this to /data/flights.db, a named-volume mount point, for you.
# An empty DB_PATH= here would NOT fall back to the default -- python-dotenv
# would set it to an actual empty string -- so leave this commented, not blank.
#DB_PATH=flights.db

# Comma-separated chat IDs allowed to use this bot at all (get yours from
# /start). Family only -- add each family member's chat ID here yourself;
# there's no self-service signup.
ALLOWED_CHAT_IDS=your-chat-id

# How often the bot ticks to check whether any flight is due for a poll.
# Real API calls only happen for flights inside their active window (see README).
SCHEDULER_TICK_MINUTES=15

# Poll cadence (minutes) once a flight is within CLOSE_EVENT_HOURS of departure/arrival.
CHECK_INTERVAL_MINUTES=30
# Poll cadence (minutes) while inside the active window but not yet close to an event.
FAR_TIER_MINUTES=120
# How many hours before scheduled departure the active window opens.
PRE_WINDOW_HOURS=6
# How close (hours) to departure/arrival counts as "close" for CHECK_INTERVAL_MINUTES.
CLOSE_EVENT_HOURS=3
# How many hours past scheduled/estimated arrival to keep polling before giving up.
POST_WINDOW_HOURS=3

# Aviationstack free tier: 100 requests/month. The bot self-throttles to stay
# under this; REQUEST_SAFETY_MARGIN requests are held in reserve for manual /status.
MONTHLY_REQUEST_CAP=100
REQUEST_SAFETY_MARGIN=5

# Default IANA timezone (e.g. "Asia/Amman") flight times are rendered in
# alongside the departure/arrival airport's own local timezone, for any chat
# that hasn't set its own via /timezone.
SUBSCRIBER_TIMEZONE=UTC

# Path to the single-instance lock file (prevents two copies of this bot
# running against the same Telegram token / database at once). Commented
# out (same reasoning as DB_PATH above): the Docker image's own
# LOCK_PATH=/data/bot.lock points at the writable named-volume mount, and
# an explicit value here would override that with a path the container's
# non-root user can't write to.
#LOCK_PATH=bot.lock
